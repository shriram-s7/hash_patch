{
  "_comment": "Expected-field manifest for testdata/certificates/*, generated by tests/golden/README_certificates.md's openssl commands. Consumed by tests/golden/test_certificates_golden.py. Validity DATES are not asserted for the three certs generated with `-days N` (relative to generation time, so not reproducible byte-for-byte) -- only structural fields (algorithm, key size, self-signed, chain position/depth, quantum status, expired flag) are. The expired cert uses explicit -not_before/-not_after, so its exact dates ARE asserted.",
  "certificates": [
    {
      "file": "valid_rsa2048.crt",
      "expected_findings": [
        {
          "name": "RSA",
          "parameter_set": "2048",
          "quantum_status": "broken-by-shor",
          "self_signed": true,
          "expired": false,
          "chain_position": 0,
          "chain_depth": 1,
          "subject_cn": "valid-rsa.example.com"
        }
      ]
    },
    {
      "file": "expired_rsa2048.crt",
      "expected_findings": [
        {
          "name": "RSA",
          "parameter_set": "2048",
          "quantum_status": "broken-by-shor",
          "self_signed": true,
          "expired": true,
          "chain_position": 0,
          "chain_depth": 1,
          "subject_cn": "expired.example.com",
          "not_before": "2020-01-01",
          "not_after": "2021-01-01",
          "shelf_life_years": 0
        }
      ]
    },
    {
      "file": "ecdsa_p256.crt",
      "expected_findings": [
        {
          "name": "ECDSA",
          "parameter_set": "P-256",
          "quantum_status": "broken-by-shor",
          "self_signed": true,
          "expired": false,
          "chain_position": 0,
          "chain_depth": 1,
          "subject_cn": "ecdsa.example.com"
        }
      ]
    },
    {
      "file": "ca_signed_chain.pem",
      "expected_findings": [
        {
          "name": "RSA",
          "parameter_set": "2048",
          "quantum_status": "broken-by-shor",
          "self_signed": false,
          "expired": false,
          "chain_position": 0,
          "chain_depth": 2,
          "subject_cn": "ca-signed-leaf.example.com",
          "issuer_cn": "HashPatch Test Root CA"
        },
        {
          "name": "RSA",
          "parameter_set": "2048",
          "quantum_status": "broken-by-shor",
          "self_signed": true,
          "expired": false,
          "chain_position": 1,
          "chain_depth": 2,
          "subject_cn": "HashPatch Test Root CA"
        }
      ]
    },
    {
      "file": "protected.p12",
      "expected_findings": [
        {
          "name": "UNPARSEABLE_CERTIFICATE",
          "finding_type": "CERTIFICATE_UNPARSEABLE",
          "error_contains": "unparseable without password"
        }
      ],
      "with_password": "testpass123",
      "expected_findings_with_password": [
        {
          "name": "RSA",
          "parameter_set": "2048",
          "quantum_status": "broken-by-shor",
          "self_signed": true,
          "expired": false,
          "chain_position": 0,
          "chain_depth": 1,
          "subject_cn": "valid-rsa.example.com"
        }
      ]
    }
  ]
}
